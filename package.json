{
  "name": "industrialis",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "turbo build",
    "commitlint": "commitlint --strict",
    "dev": "turbo dev",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "test": "turbo test",
    "typecheck": "pnpm --filter @industrialis/server-contracts build && pnpm --recursive --if-present typecheck",
    "dev:launcher": "pnpm --filter @industrialis/launcher dev",
    "dev:website": "turbo dev --filter=@industrialis/website",
    "dev:server": "turbo dev --filter=@industrialis/server",
    "dev:dashboard": "turbo dev --filter=@industrialis/dashboard",
    "build:launcher": "turbo build --filter=@industrialis/launcher",
    "build:launcher:release": "node scripts/run-build-launcher.mjs",
    "build:launcher:installer": "node scripts/run-build-launcher.mjs installer",
    "build:launcher:portable": "node scripts/run-build-launcher.mjs portable",
    "build:website": "turbo build --filter=@industrialis/website",
    "build:server": "turbo build --filter=@industrialis/server",
    "build:dashboard": "turbo build --filter=@industrialis/dashboard",
    "pack:server": "node scripts/pack-server-release.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "^2.10.6",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller",
      "esbuild",
      "fs-xattr",
      "lefthook",
      "macos-alias",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@electron/packager>extract-zip": "file:./scripts/extract-zip-node24"
    }
  }
}
