{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "industrialis-launcher",
  "version": "0.1.0",
  "identifier": "com.yoggan.industrialis",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Industrialis Launcher",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/industrialis-launcher/instances/**/*",
          "$DATA/industrialis-launcher/instances/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["industrialislauncher"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RDk1NzA0MjRDMjk5MTQKUldRVW1jSWtCRmZacWVHcm14V1NGTjN3V0pCaWR1YXZ6RTFRS1VUejhuMWwrdVhwNlVQSlZ5SVgK",
      "endpoints": [
        "https://github.com/SergioJuniorCE/industrialis-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
