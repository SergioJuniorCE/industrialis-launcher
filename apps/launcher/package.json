{
  "name": "@industrialis/launcher",
  "private": true,
  "version": "0.4.2",
  "description": "Industrialis native desktop launcher",
  "scripts": {
    "dev": "node ../../scripts/dev-launcher.mjs",
    "dev:once": "cargo run -p industrialis-app --locked --jobs 2",
    "build": "cargo build --workspace --locked --jobs 1",
    "package": "node ../../scripts/build-launcher.mjs",
    "test": "cargo test --workspace --lib --bins --tests --locked --jobs 1"
  }
}
