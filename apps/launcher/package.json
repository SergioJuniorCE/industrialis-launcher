{
  "name": "@industrialis/launcher",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "dev:frontend": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.renderer.config.ts && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:frontend": "tsc -p tsconfig.json --noEmit && vite build --config vite.renderer.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "package": "node ../../scripts/check-launcher-node.mjs && electron-forge package",
    "make": "node ../../scripts/check-launcher-node.mjs && electron-forge make"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@radix-ui/primitive": "^1.1.4",
    "@radix-ui/react-context": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@uiw/react-codemirror": "^4.25.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.0.0",
    "scheduler": "^0.27.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.3.0",
    "fflate": "^0.8.2",
    "lodash": "^4.18.1",
    "jsdom": "^26.1.0",
    "react-grab": "^0.1.47",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
