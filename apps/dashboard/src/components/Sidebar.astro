---
interface Props {
  current: "fleet" | "docs";
}

const { current } = Astro.props;

const linkBase = "flex items-center gap-3 border-l-2 px-3 py-2 text-xs font-medium";
const activeClasses = "border-signal bg-signal-dark text-copy";
const idleClasses = "border-transparent text-dim transition hover:text-copy";
---

<aside class="border-b border-line bg-panel/95 px-5 py-4 lg:min-h-[100dvh] lg:border-b-0 lg:border-r lg:py-6">
  <div class="flex items-center gap-3">
    <div class="grid size-8 place-items-center bg-signal text-ink">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-semibold tracking-tight">Industrialis</p>
      <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-dim">Server console</p>
    </div>
  </div>
  <nav class="mt-5 flex gap-2 lg:mt-10 lg:block lg:space-y-1">
    <a
      href="/"
      class:list={[linkBase, current === "fleet" ? activeClasses : idleClasses]}
      aria-current={current === "fleet" ? "page" : undefined}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class:list={["size-4", current === "fleet" && "text-signal"]}
        aria-hidden="true"
      >
        <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
        <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
        <line x1="6" x2="6.01" y1="6" y2="6" />
        <line x1="6" x2="6.01" y1="18" y2="18" />
      </svg>
      Fleet
    </a>
    <a
      href="/docs"
      class:list={[linkBase, current === "docs" ? activeClasses : idleClasses]}
      aria-current={current === "docs" ? "page" : undefined}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class:list={["size-4", current === "docs" && "text-signal"]}
        aria-hidden="true"
      >
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
      </svg>
      Docs
    </a>
  </nav>
  <div class="mt-6 hidden border-t border-line pt-5 lg:block">
    <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-dim">Daemon</p>
    <p class="mt-2 truncate font-mono text-[10px] text-copy">Authenticated local proxy</p>
  </div>
</aside>
