[Unit]
Description=Industrialis GTNH server daemon
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=industrialis
Group=industrialis
SupplementaryGroups=docker
WorkingDirectory=/opt/industrialis
EnvironmentFile=/etc/industrialis/industrialis.env
# Monorepo checkout layout. For a release install, point at the industrialis binary:
# ExecStart=/usr/local/bin/industrialis daemon
ExecStart=/usr/bin/env node apps/server/dist/cli.js daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/industrialis

[Install]
WantedBy=multi-user.target
