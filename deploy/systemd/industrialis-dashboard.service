[Unit]
Description=Industrialis GTNH server dashboard
After=network-online.target industrialis-server.service
Wants=network-online.target
Requires=industrialis-server.service

[Service]
Type=simple
User=industrialis
Group=industrialis
WorkingDirectory=/opt/industrialis
EnvironmentFile=/etc/industrialis/industrialis.env
Environment=HOST=127.0.0.1
Environment=PORT=3001
# Monorepo checkout layout (Astro Node standalone). For a release install:
# ExecStart=/usr/bin/env node /usr/local/share/industrialis/dashboard/server/entry.mjs
ExecStart=/usr/bin/env node apps/dashboard/dist/server/entry.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
