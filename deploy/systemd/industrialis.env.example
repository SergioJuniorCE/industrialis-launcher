# Install this file as /etc/industrialis/industrialis.env.
INDUSTRIALIS_HOST=127.0.0.1
INDUSTRIALIS_PORT=4310
INDUSTRIALIS_API_URL=http://127.0.0.1:4310
INDUSTRIALIS_SERVER_DATA=/var/lib/industrialis/servers
INDUSTRIALIS_DOCKER_SOCKET=/var/run/docker.sock
INDUSTRIALIS_GTNH_IMAGE=ghcr.io/debuas/gtnhserverdocker
INDUSTRIALIS_DASHBOARD_HOST=127.0.0.1
INDUSTRIALIS_DASHBOARD_PORT=3001

# Optional: set one explicit shared secret. If omitted, the daemon generates
# /var/lib/industrialis/servers/.api-token for the dashboard service to read.
# INDUSTRIALIS_API_TOKEN=replace-with-a-long-random-value
